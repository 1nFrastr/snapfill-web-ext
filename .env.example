# 复制为 .env.local 后填写（.env.local 已 gitignore，勿提交）
# 仅本地 `pnpm dev` / CLI 使用；`pnpm build` / `zip` 不会把密钥打进产物。
#
# 变量须以 WXT_ 开头（WXT/Vite 约定）

# DeepSeek（Agent）
WXT_DEEPSEEK_API_KEY=
WXT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
WXT_DEEPSEEK_MODEL=deepseek-v4-flash
WXT_DEEPSEEK_TIMEOUT_MS=180000

# 后端 API（Base URL 仍须在 lib/settings/allowlist.ts 白名单内）
WXT_API_BASE_URL=http://127.0.0.1:8008
WXT_API_TIMEOUT_MS=120000
WXT_API_DEFAULT_USERNAME=19900000001
WXT_API_DEFAULT_PASSWORD=
WXT_DEVICE_ID_PREFIX=web-ext

# 本地联调免登录：填一个现成的 access_token，dev 版启动时自动写进 storage
# （不覆盖已有登录态；侧栏点「退出登录」后不再自动播种，直到重新登录）
WXT_API_DEV_TOKEN=
WXT_API_DEV_TOKEN_USER=
